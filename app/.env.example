# ════════════════════════════════════════════════════════════════════════════════════════════════
# RAGNABOT — ESPELHO DAS VARIÁVEIS DE AMBIENTE  (ARQUIVO DE EXEMPLO, VERSIONADO)
#
# ⛔ LEI 1 DA CASA: NENHUM VALOR REAL ENTRA AQUI. Este arquivo só existe para dizer QUAIS chaves
#    existem e o que cada uma faz. Os valores vivem em `.env` (fora do git) e no `Secret` do
#    Kubernetes `ragnabot-motor-env` (criado à mão no servidor — ver `deploy/ragnabot-motor.yaml`).
#
# Como usar em desenvolvimento:
#     cp .env.example .env      # e preencha os valores no .env, que é ignorado pelo git
#
# Legenda:  «PREENCHER» = o dono/chefe precisa fornecer o valor.
# ════════════════════════════════════════════════════════════════════════════════════════════════

# ── PROCESSO ────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
TZ=America/Fortaleza
LOG_LEVEL=debug

# ── BANCO ───────────────────────────────────────────────────────────────────────────────────────
# ⚠️ O LÍDER DO PATRONI MUDA. Aponte para o serviço `banco-lider` (HAProxy que segue o primário),
#    NUNCA para o IP de um nó. Supor qual nó é o primário foi o que quebrou o backup em 29/08.
DATABASE_URL=postgresql://«PREENCHER»@banco-lider:5432/ragnabot

# ⚠️ A MESMA chave do NOC enquanto houver dado cifrado migrado: 64 caracteres hex (32 bytes).
#    Com chave diferente, todo segredo já gravado NÃO ABRE — e o erro aparece no meio de um
#    atendimento, não na partida.
ENCRYPTION_KEY=«PREENCHER — 64 hex»

# ── PLATAFORMA DE ATENDIMENTO ───────────────────────────────────────────────────────────────────
RAGNABOT_BASE_URL=https://bot.ragnatela.com.br
RAGNABOT_PLATFORM_TOKEN=«PREENCHER — token do Platform App; é a chave de TODAS as empresas»
RAGNABOT_WEBHOOK_SEGREDO=«PREENCHER — segredo do webhook plataforma → motor»
RAGNABOT_HTTP_TIMEOUT_MS=20000
RAGNABOT_SUSPENSAO_MODO=remover_vinculos
# RAGNABOT_PROXY_IP=
# RAGNABOT_PLATAFORMA_INTERNA=

# ── SESSÃO DA INTERFACE PRÓPRIA ─────────────────────────────────────────────────────────────────
RAGNABOT_SESSAO_SEGREDO=«PREENCHER — segredo de assinatura do cookie de sessão»
RAGNABOT_SESSAO_HORAS=12
# Só em desenvolvimento sem HTTPS. NUNCA em produção.
# RAGNABOT_SESSAO_COOKIE_INSEGURO=1
RAGNABOT_TRUST_PROXY=1

# ── ⛔ QUEM É O OPERADOR DO SaaS (contrato S7 — ordem do dono, 02/09/2026) ───────────────────────
# «whitelabel, empresas e planos só aparecem na conta que vende o SaaS — na conta de cliente não».
#
# Estas duas variáveis dizem QUAL empresa é a nossa. Sem NENHUMA delas, o produto FALHA FECHADO:
# nenhuma sessão de navegador alcança esses painéis, e só o super usuário pelo token de serviço
# (o console de operação) passa. É de propósito — permissão que erra para o lado aberto é,
# literalmente, como se vaza empresa. No pior caso alguém legítimo leva 403 e a variável é
# declarada, com nome e critério.
#
# ⚠️ NÃO deduzimos «é a Ragnatela» pelo nome ou pelo slug da empresa: nome é dado de cadastro,
# editável pela própria tela de Empresas — uma empresa cliente que se renomeasse "Ragnatela"
# herdaria o SaaS inteiro. O que manda tem de ser algo que o cliente não escreve.
#
# Basta UMA das duas; declarar as duas é aceito (qualquer uma que case concede).
# RAGNABOT_TENANT_OPERADOR=«uuid do RagnabotTenant da Ragnatela»
# RAGNABOT_CONTA_OPERADORA=1

# ── EXECUTOR DO MOTOR DE FLUXO (a fila) ─────────────────────────────────────────────────────────
# O laço que tira trabalho de `RagnabotFluxoFila` e faz a conversa andar. PADRÃO: LIGADO — a
# variável ausente tem de ser o que atende o cliente.
#
# ⚠️ DESLIGAR ISTO NÃO PARA O RECEBIMENTO: a portaria continua gravando a mensagem e o trabalho
# continua entrando na fila. O que para é o CONSUMO — ou seja, o robô deixa de responder e a fila
# cresce. É o freio para um aperto (investigar sem falar com cliente), nunca um estado de repouso.
# Acompanhe `filaDoMotor` em `GET /saude` enquanto estiver desligado.
# Aceita 0 | off | false | nao para desligar.
# RAGNABOT_EXECUTOR_FLUXO=0
#
# Tique do laço, em milissegundos. Padrão 500. A especificação sugere 250 (o cliente está esperando
# no meio de uma frase); 500 é o meio-termo com o custo de consulta ociosa por réplica.
# RAGNABOT_EXECUTOR_INTERVALO_MS=500

# ── AGENDAMENTO DE MENSAGENS (contrato S4) ──────────────────────────────────────────────────────
# O trabalhador que dispara as mensagens agendadas. PADRÃO: DESLIGADO — e o padrão é o INVERSO do
# executor de fluxo, de propósito.
#
# O executor RESPONDE a quem escreveu; este COMEÇA conversa. Um trabalhador que começa conversa
# subindo sozinho num processo recém-implantado, com agendas antigas vencidas no banco, dispararia
# de uma vez tudo o que ficou para trás — a forma do alerta de backup que mandou 210 mensagens.
#
# ⚠️ DESLIGADO, o cadastro CONTINUA funcionando: a tela e as rotas respondem, as agendas nascem e
# ficam pendentes. O que não acontece é o disparo.
# 📌 Recomendação registrada: ao ligar pela primeira vez, ligar com UMA agenda de teste para um
#    número da casa — nunca estreando em cima de agenda de cliente.
# Aceita 1 | true | sim | on para ligar.
# RAGNABOT_AGENDAMENTO=1
#
# Tique do laço, em milissegundos. Padrão 30000 (30 s), mínimo 10000. A granularidade útil de um
# agendamento é o MINUTO — ninguém marca «às 8h00m30s» —, e meio minuto garante que a agenda das
# 8h saia às 8h e não às 8h01, sem transformar o banco em alvo de consulta a cada segundo.
# RAGNABOT_AGENDAMENTO_INTERVALO_MS=30000

# ── E-MAIL (SMTP PRÓPRIO) ───────────────────────────────────────────────────────────────────────
SMTP_HOST=«PREENCHER»
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=«PREENCHER»
SMTP_PASSWORD=«PREENCHER»
SMTP_FROM=«PREENCHER»
SMTP_FROM_NAME=Ragnabot

# ── BACKUP (bucket IMUTÁVEL — não é o dos anexos) ───────────────────────────────────────────────
RAGNABOT_S3_ENDPOINT=«PREENCHER»
RAGNABOT_S3_REGION=«PREENCHER»
RAGNABOT_S3_BUCKET=«PREENCHER»
RAGNABOT_S3_ACCESS_KEY=«PREENCHER»
RAGNABOT_S3_SECRET_KEY=«PREENCHER»

# ════════════════════════════════════════════════════════════════════════════════════════════════
# COBRANÇA DO SaaS (a mensalidade que o cliente paga A NÓS) — `ragnabot-cobranca.service.js`
# API de Cobranças da Efí (boleto/carnê/cartão). NÃO exige certificado.
# ════════════════════════════════════════════════════════════════════════════════════════════════
RAGNABOT_COBRANCA_ADAPTADOR=manual
# TRAVA MESTRA: 1 = o serviço pode MESMO liberar/suspender a conta do cliente.
RAGNABOT_COBRANCA_APLICAR=0
RAGNABOT_COBRANCA_WEBHOOK_SEGREDO=«PREENCHER»
RAGNABOT_PUBLIC_URL=https://bot.ragnatela.com.br
RAGNABOT_DB_URL=«PREENCHER — base da plataforma, só para liberar/suspender conta»
RAGNABOT_PIX_CHAVE=«PREENCHER — chave Pix do adaptador manual»
RAGNABOT_PIX_NOME=RAGNATELA IOT SOLUTIONS
RAGNABOT_PIX_CIDADE=SAO LUIS
EFI_AMBIENTE=homologacao
EFI_CLIENT_ID=«PREENCHER — API de Cobranças»
EFI_CLIENT_SECRET=«PREENCHER — API de Cobranças»

# ════════════════════════════════════════════════════════════════════════════════════════════════
# PAGAMENTO PIX NA CONVERSA (a empresa cliente cobrando o cliente DELA) — S-EFÍ / doc 36
#
# ⚠️ É OUTRA API e OUTRO PAR DE CREDENCIAIS: a API Pix exige CERTIFICADO (.p12) e mTLS.
# ⚠️ HOMOLOGAÇÃO É O PADRÃO. Só a palavra exata `producao` liga produção.
# ⛔ O certificado NUNCA entra no git nem no banco: é um arquivo montado por Secret, e aqui vai só
#    o CAMINHO dele dentro do contêiner.
# ⛔ FALTA DE INFRA, e não de código: o webhook do Pix exige mTLS DE ENTRADA (a Efí apresenta o
#    certificado, nós validamos) num vhost isolado do nginx — doc 36 §3.1. Sem ele, a confirmação
#    automática não fecha o ciclo, e o certo é continuar em homologação.
# ════════════════════════════════════════════════════════════════════════════════════════════════
EFI_PIX_AMBIENTE=homologacao
EFI_PIX_CLIENT_ID=«PREENCHER — API Pix (par próprio, diferente do de Cobranças)»
EFI_PIX_CLIENT_SECRET=«PREENCHER — API Pix»
EFI_PIX_CERT_PATH=/etc/ragnabot/efi/certificado.p12
EFI_PIX_CERT_SENHA=«PREENCHER — senha do .p12 (vazia é comum na Efí)»
EFI_PIX_CHAVE=«PREENCHER — chave Pix RECEBEDORA cadastrada na conta Efí»
# Segredo que viaja NA URL do webhook. Sem ele, o endpoint recusa com 503 em vez de ficar aberto.
EFI_PIX_WEBHOOK_HMAC=«PREENCHER — string longa e aleatória»
# Endereço público que a Efí vai chamar (registrado com `?ignorar=` para ela não colar "/pix").
EFI_PIX_WEBHOOK_URL=https://pix.ragnatela.com.br/api/ragnabot-pagamento/pix/«O MESMO HMAC ACIMA»
# IPs aceitos, separados por vírgula. O padrão é o publicado pela Efí.
EFI_PIX_WEBHOOK_IPS=34.193.116.226
EFI_PIX_EXPIRACAO_SEGUNDOS=3600
EFI_PIX_TIMEOUT_MS=20000

# ════════════════════════════════════════════════════════════════════════════════════════════════
# CAPITÃO — o agente de IA da plataforma (S5 / doc 34 §2.C)
#
# ⛔ NASCE DESLIGADO, e é assim que fica até o dono decidir a questão da LICENÇA da edição paga da
#    plataforma (doc 34, §2.C, último parágrafo). Só `1`, `true` ou `sim` ligam; qualquer outra
#    coisa mantém desligado.
# ⚠️ A chave da OpenAI (`CAPTAIN_OPEN_AI_API_KEY`) é da PLATAFORMA, não deste processo — ela vive
#    no ambiente do Chatwoot. Este interruptor é o NOSSO: ele decide se a nossa camada chega a
#    perguntar alguma coisa ao agente.
# ════════════════════════════════════════════════════════════════════════════════════════════════
CAPITAO_ATIVO=false
# Custo ESTIMADO por resposta e por mil tokens, em centavos. A plataforma não devolve o custo real;
# estes números alimentam a medição por atendimento, que sai sempre rotulada como estimativa.
CAPITAO_CUSTO_RESPOSTA_CENTAVOS=0
CAPITAO_CUSTO_MIL_TOKENS_CENTAVOS=0
# Rede de proteção da instalação inteira (soma de todas as empresas). 0 = sem teto global — o teto
# por empresa (plano + acordo individual) continua valendo.
CAPITAO_TETO_GLOBAL_RESPOSTAS_MES=0
CAPITAO_TEMPO_LIMITE_MS=20000
